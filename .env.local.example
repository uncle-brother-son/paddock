# ============================================
# REQUIRED - Project Configuration
# ============================================
# Project name is automatically derived from root folder name
# (e.g., if folder is 'client-project', that becomes the project name)

# Production domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://thepaddockwellnessclub.co.uk/

# ============================================
# REQUIRED - Sanity CMS
# ============================================
# Find these in: https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=qx4gqx7t
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Webhook secret for instant revalidation
# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SANITY_REVALIDATE_SECRET=ShD2Q2o5M6+0xIEnBfZvKGk9wlQ4LT9DgL2ntAIZwAI=

# ============================================
# REQUIRED - Cloudflare Workers
# ============================================
# Run: wrangler kv:namespace create NEXT_INC_CACHE_KV
CLOUDFLARE_KV_NAMESPACE_ID=your_kv_namespace_id

# Run: wrangler d1 create {project-name}-tag-cache
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_D1_DATABASE_NAME=your-project-name-tag-cache

# ============================================
# REQUIRED - Supabase (Auth + Database)
# ============================================
# Find these in: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key (secret - never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Direct Postgres connection (for server-side queries)
# Find in: Project Settings → Database → Connection string (Transaction mode)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ============================================
# REQUIRED - Google Analytics
# ============================================
# GA4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-N1QJG92Y7C

# ============================================
# OPTIONAL - Branding Customization
# ============================================
# Font setup (custom fonts always used - folder will be created)
# Just update the font filenames in globals.css after adding your font files
