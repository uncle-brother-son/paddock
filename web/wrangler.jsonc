{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paddock",
  "compatibility_date": "2024-11-21",
  // W12: the custom worker (custom-worker.ts) wraps OpenNext's generated .open-next/worker.js, unchanged
  // for every request, and adds the scheduled handler that runs reconcile (server/scheduled.ts).
  "main": "custom-worker.ts",
  // Every 5 minutes (W03-decisions Q14). Switching it off is removing this line and deploying (W03-plan 3.3).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // The custom worker reaches the server code directly, outside Next's build. Next swaps the `server-only`
  // marker for an empty module on the server; wrangler's bundle needs the same (vitest.unit.config.ts too).
  "alias": {
    "server-only": "./node_modules/next/dist/compiled/server-only/empty.js"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "paddock"
    }
  ],
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "623c1cfa23d340e9bd435c2d5664d06d"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_id": "9b8c0eea-ef00-409c-867b-fc03fa5c0f85",
      "database_name": "paddock-tag-cache"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6947ef9003b84e0581dba6509bc4f5bc",
      // Only used by local tools (wrangler dev, and the OpenNext deploy step, which reads the
      // bindings locally and fails without it). The live Worker always uses the Hyperdrive id above.
      // No password here: it points at a local Supabase, never the real database.
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54322/postgres"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
